{
  "name": "studio",
  "version": "1.0.0",
  "private": true,
  "keywords": [
    "sanity"
  ],
  "license": "UNLICENSED",
  "main": "package.json",
  "scripts": {
    "build": "sanity build",
    "deploy": "sanity deploy",
    "predev": "npm run sanity:typegen",
    "dev": "sanity dev",
    "sanity:typegen": "sanity schema extract --enforce-required-fields --force --path ../sanity.schema.json && sanity typegen generate",
    "seed:guide": "sanity exec scripts/seed-guide/index.ts --with-user-token --",
    "start": "sanity start",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@sanity/assist": "^6.2.2",
    "@sanity/code-input": "^7.3.9",
    "@sanity/document-internationalization": "^6.2.39",
    "@sanity/icons": "^5.2.3",
    "@sanity/vision": "^6.18.0",
    "date-fns": "^4.4.0",
    "pluralize-esm": "^9.0.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "rxjs": "^7.8.2",
    "sanity": "^6.18.0",
    "sanity-plugin-asset-source-unsplash": "^7.0.26",
    "sanity-plugin-internationalized-array": "^5.3.2",
    "styled-components": "^6.4.2"
  },
  "devDependencies": {
    "@sanity/eslint-config-studio": "^6.0.0",
    "@types/react": "^19.2.16",
    "typescript": "^5.9.3"
  }
}
